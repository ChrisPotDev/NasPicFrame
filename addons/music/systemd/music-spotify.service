[Unit]
Description=NasPicFrame music add-on: Spotify Connect (librespot)
# Started and stopped by the coordinator according to music.ini.
PartOf=music-coordinator.service
After=pipewire-pulse.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/picframe-music/launch.py spotify --config /etc/picframe/music.ini
Restart=always
RestartSec=5
