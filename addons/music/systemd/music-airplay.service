[Unit]
Description=NasPicFrame music add-on: AirPlay (shairport-sync)
# Started and stopped by the coordinator according to music.ini.
PartOf=music-coordinator.service
After=pipewire-pulse.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/picframe-music/launch.py airplay --config /etc/picframe/music.ini
Restart=always
RestartSec=5
